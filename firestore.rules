rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Anyone signed in with a verified @lemonly.com or @clickrain.com Google account can read;
// only nick@lemonly.com can write. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isCompanyGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(lemonly|clickrain)[.]com$');
    }

    function isEditor() {
      return isCompanyGoogleUser()
        && request.auth.token.email.lower() == 'nick@lemonly.com';
    }

    match /planners/{plannerId} {
      allow read: if isCompanyGoogleUser();
      allow write: if isEditor();
    }
  }
}
